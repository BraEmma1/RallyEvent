# Rally — environment variables (copy to .env, never commit real values)

# ---- Supabase ----
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server only, never expose to client
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# ---- Frontend (Vite: only VITE_* vars are exposed to the browser) ----
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key
VITE_API_BASE_URL=http://localhost:4000

# ---- Auth / tokens (server) ----
JWT_SECRET=generate_a_long_random_string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ---- Signed registration handoff ----
HANDOFF_HMAC_SECRET=shared_secret_with_organizer_systems
HANDOFF_TOKEN_TTL=10m

# ---- QR profile tokens ----
QR_TOKEN_SECRET=another_long_random_string
QR_TOKEN_TTL=24h

# ---- Email OTP provider (pilot: use Supabase Auth email, or override) ----
# POSTMARK_TOKEN=xxxx           # optional if not using Supabase email
# EMAIL_FROM=hello@rally.app

# ---- Phone OTP (POST-PILOT ONLY — leave blank for the pilot) ----
# WHATSAPP_BUSINESS_TOKEN=
# WHATSAPP_PHONE_ID=
# SMS_PROVIDER_KEY=            # Africa's Talking / Twilio fallback

# ---- App ----
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
